local function pollenStorm(r)
	local cam = workspace.CurrentCamera
	local holder = Instance.new("Part")
	holder.Name = "PollenStorm"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(40, 20, 40)
	holder.Parent = workspace
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90))
	pe.LightEmission = 0.6
	pe.Size = NumberSequence.new(0.35, 0.15)
	pe.Lifetime = NumberRange.new(2, 3.5)
	pe.Rate = 160
	pe.Speed = NumberRange.new(4, 9)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Parent = holder
	local untilT = os.clock() + 12
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if ride ~= r or os.clock() > untilT then
			pe.Enabled = false
			conn:Disconnect()
			task.delay(4, function()
				holder:Destroy()
			end)
			return
		end
		holder.CFrame = cam.CFrame * CFrame.new(0, 0, -20)
	end)
end

runEvent = function(r, ev)
	if ev == 1 then
		say(
			"🦠 شوف! المستعمرات البكتيرية تكبر قدامك (كل خلية تنقسم لثنتين)",
			5
		)
		for _, e in ipairs(evtParts[1]) do
			TweenService
				:Create(e.part, TweenInfo.new(9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = e.size })
				:Play()
		end
	elseif ev == 2 then
		say("🌼 عاصفة لقاح! حبوب اللقاح تنتقل بالهوا من زهرة لزهرة", 5)
		pollenStorm(r)
	elseif ev == 3 then
		say("🔦 شغّلنا ضوء UV: البصمات المخفية بانت على الجدران!", 5)
		for _, e in ipairs(evtParts[3]) do
			TweenService:Create(e.part, TweenInfo.new(1.5), { Transparency = 0.15 }):Play()
		end
	end
end

local function passFlags(r, fromIdx, toIdx)
	for i = fromIdx + 1, toIdx do
		local p = pts[i]
		if p.flags.c and p.label ~= "" then
			say(p.label, 5) -- v54: landmark captions replace the floating boards beside the rails
		end
		local ev = p.flags.e
		if type(ev) == "number" and not r.events[ev] then
			r.events[ev] = true
			runEvent(r, ev)
		end
		local sec = p.flags.s
		if type(sec) == "number" and sec >= 1 and p.label ~= "" then
			r.section = sec
			say(p.label, 3)
			local fact = FACTS[sec]
			if fact then
				task.delay(3.2, function()
					if ride == r and r.section == sec then
						say(fact, 6)
					end
				end)
			end
		end
	end
end

RunService.RenderStepped:Connect(function(dt)
	local r = ride
	if not r then
		return
	end
	caption.Visible = os.clock() < captionUntil
	if not (r.seat.Parent and r.hum.Parent) or r.hum.Health <= 0 then
		endRide("stop")
		return
	end
	dt = math.min(dt, 1 / 20)
	-- cruise target -> bend comfort -> a smooth stop at the end of the line
	local target = r.state == "running" and SPEEDS[r.level] or 0
	-- v53: drops feel like drops (up to +45% downhill, -20% on climbs); never above the bend comfort limit
	local _, slopeDir = frameAt(r.d)
	target *= 1 + math.clamp(-slopeDir.Y * 3, -0.2, 0.45)
	target = math.min(target, bendLimit(r.d), math.sqrt(2 * DECEL * math.max(total - r.d, 0)))
	if r.v < target then
		r.v = math.min(target, r.v + ACCEL * dt)
	else
		r.v = math.max(target, r.v - DECEL * dt)
	end
	r.d = math.min(r.d + r.v * dt, total)
	if r.state == "running" and r.d >= total - 0.5 and r.v < 1 then
		r.v = 0
		setState(r, "finished")
		play("achievement")
		local milestone = ReplicatedStorage:FindFirstChild("Milestone")
		if milestone then
			milestone:FireServer("cartFinish")
		end
	end
	local frame, dir = frameAt(r.d)
	local _, _, _, idx = sample(r.d)
	passFlags(r, r.idx, idx)
	r.idx = math.max(r.idx, idx)
	-- ease the rotation (position stays exactly on the rail) so bends feel smooth, not jittery
	local ease = 1 - math.exp(-dt * 10)
	local rot = r.lastRot and r.lastRot:Lerp(frame.Rotation, ease) or frame.Rotation
	r.lastRot = rot
	r.seat.CFrame = CFrame.new(frame.Position) * rot
	r.seat.AssemblyLinearVelocity = dir * r.v
	r.seat.AssemblyAngularVelocity = Vector3.zero
	placeCars(r)
	if r.cinematic then
		-- chase camera: behind and above the train, looking down the line; eased so bends stay smooth
		local cam = workspace.CurrentCamera
		local look = frameAt(math.min(r.d + 40, total)).Position
		local want = CFrame.lookAt(frame.Position - dir * 52 + Vector3.yAxis * 18, look)
		cam.CFrame = cam.CFrame:Lerp(want, 1 - math.exp(-dt * 4))
	end
	local stateText = STATE_TEXT[r.state] or ""
	status.Text = r.state == "running" and ("%s • السرعة %d/%d"):format(stateText, r.level, #SPEEDS)
		or stateText
	local sec = r.section or 0
	if sec >= 1 then
		local s0 = stageStart[sec] or 0
		local s1 = stageStart[sec + 1] or total
		progressText.Text = ("المرحلة %d/8 • %s • %d%%"):format(
			sec,
			STAGE_NAMES[sec] or "",
			math.floor(math.clamp((r.d - s0) / math.max(s1 - s0, 1), 0, 1) * 100)
		)
	else
		progressText.Text = "🚆 المحطة • 8 عوالم بانتظارك"
	end
	fill.Size = UDim2.fromScale(r.d / total, 1)
end)

remote.OnClientEvent:Connect(function(action, cart)
	if action ~= "start" or not cart then
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local seat = cart:WaitForChild("Seat", 5)
	if not (hum and seat) then
		return
	end
	if ride then
		endRide("stop")
	end
	local r = {
		cart = cart,
		seat = seat,
		hum = hum,
		d = 0,
		v = 0,
		idx = 0,
		level = START_LEVEL,
		state = "ready",
		cars = {},
		conns = {},
		events = {},
		cinematic = false,
	}
	ride = r
	resetEvents()
	if carTemplate then
		for k = 1, 3 do
			local car = carTemplate:Clone()
			car.Name = "LocalCartCar" .. k
			car.PrimaryPart = car:FindFirstChild("CarBody") -- pivot on the car floor (the template's own pivot is arbitrary)
			for _, p in ipairs(car:GetDescendants()) do
				if p:IsA("BasePart") then
					p.Anchored = true
					p.CanCollide = false
					p.CanQuery = false
					p.CanTouch = false
				end
			end
			car.Parent = workspace
			table.insert(r.cars, car)
		end
	end
	local frame = frameAt(0)
	r.seat.CFrame = frame
	r.lastRot = frame.Rotation
	placeCars(r)
	local milestone = ReplicatedStorage:FindFirstChild("Milestone")
	if milestone then
		milestone:FireServer("cartStart")
	end
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	cam.CameraSubject = hum
	gui.Enabled = true
	refreshUI(r)
	say(
		"🚆 أهلاً! اضغط ▶ مرة وحدة والقطار يمشي بروحه • ＋/－ للسرعة • 🎥 للكاميرا",
		5
	)
	-- Wire 3D physical buttons mounted on the cart dashboard
	local function wireCartBtn(partName, fn)
		local p = cart:FindFirstChild(partName, true)
		local cd = p and p:FindFirstChildOfClass("ClickDetector")
		if cd then
			table.insert(
				r.conns,
				cd.MouseClick:Connect(function(clicker)
					if clicker == player and ride == r then
						fn()
					end
				end)
			)
		end
	end
	wireCartBtn("CartBtn_Go", toggleGo)
	wireCartBtn("CartBtn_Faster", function()
		changeSpeed(1)
	end)
	wireCartBtn("CartBtn_Slower", function()
		changeSpeed(-1)
	end)
	wireCartBtn("CartBtn_Horn", function()
		play("sting")
		say("🚂 توت توت! قطار التخصصات البيولوجية ينطلق", 2.5)
	end)
	-- jumping out of the seat ends the ride (back on the platform); dying ends it too
	table.insert(
		r.conns,
		hum:GetPropertyChangedSignal("Sit"):Connect(function()
			if not hum.Sit then
				task.wait(0.2)
				if ride == r and not hum.Sit then
					endRide("station")
				end
			end
		end)
	)
	table.insert(
		r.conns,
		hum.Died:Connect(function()
			if ride == r then
				endRide("stop")
			end
		end)
	)
end)
