-- ------------------------------------------------------------------ track
local okTrack, track = pcall(function()
	return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("CartTrack", 10))
end)
if not (okTrack and type(track) == "table") then
	return
end
local pts = {}
for i, row in ipairs(track) do
	local flags = {}
	for _, f in ipairs(string.split(row[6] or "", ",")) do
		if f ~= "" then
			local key, num = f:match("^(%a+)(%d*)$")
			if key then
				flags[key] = tonumber(num) or true
			end
		end
	end
	pts[i] = {
		pos = Vector3.new(row[1], row[2], row[3]),
		right = Vector3.new(row[4], 0, row[5]),
		flags = flags,
		label = row[7] or "",
	}
end
if #pts < 2 then
	return
end
local dist = { 0 }
for i = 2, #pts do
	dist[i] = dist[i - 1] + (pts[i].pos - pts[i - 1].pos).Magnitude
end
local total = dist[#pts]
-- where each stage starts along the track (for the progress bar)
local STAGE_NAMES = {
	"مايكروبيولوجي",
	"بايوكيمستري",
	"بيولوجيا حيوان",
	"بيولوجيا نبات",
	"مولكلر",
	"الأدلة الجنائية",
	"الزراعة",
	"البايوتكنولوجي",
}
local stageStart = {}
for i, p in ipairs(pts) do
	local sec = p.flags.s
	if type(sec) == "number" and sec >= 1 then
		stageStart[sec] = dist[i]
	end
end

