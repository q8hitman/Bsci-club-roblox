-- v56 Cart Ride streaming: the eight specialty valleys (floors, walls, track, scenery) are not in the Map. Each one is
-- a compact text module (Shared/CartScenery/V<k>, generated by tools/cart_tour53.py) that this script builds locally
-- when the camera gets near: the valley you are in plus its neighbours, a few hundred parts per frame (the dark tunnels
-- between valleys hide the work). Far valleys are destroyed. The server only keeps the station.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local shared = ReplicatedStorage:WaitForChild("Shared")
local folder = shared:WaitForChild("CartScenery", 30)
local okRooms, rooms = pcall(function()
	return require(shared:WaitForChild("CartRooms", 10))
end)
if not (folder and okRooms and type(rooms) == "table" and rooms.edges) then
	return
end
local edges = rooms.edges -- world x where valley k begins (descending)
local COUNT = #edges
local PER_FRAME = 350

local MATERIALS = {}
for _, m in ipairs(Enum.Material:GetEnumItems()) do
	MATERIALS[m.Value] = m
end
local SHAPES = { B = Enum.PartType.Block, S = Enum.PartType.Ball, C = Enum.PartType.Cylinder }
local FACES = {
	Front = Enum.NormalId.Front,
	Back = Enum.NormalId.Back,
	Left = Enum.NormalId.Left,
	Right = Enum.NormalId.Right,
	Top = Enum.NormalId.Top,
	Bottom = Enum.NormalId.Bottom,
}

local function hex(s)
	return Color3.fromRGB(tonumber(s:sub(1, 2), 16), tonumber(s:sub(3, 4), 16), tonumber(s:sub(5, 6), 16))
end

local root = Instance.new("Folder")
root.Name = "CartScenery"
root.Parent = workspace

local loaded = {} -- k -> { folder, done }
local sources = {}

-- one valley at a time, in priority order (current, next, previous), so two builds never share a frame
local queue = {}
local function build(k)
	local entry = { folder = Instance.new("Folder"), done = false }
	entry.folder.Name = "Valley" .. k
	entry.folder.Parent = root
	loaded[k] = entry
	table.insert(queue, {
		k = k,
		entry = entry,
		run = function()
			local mod = folder:FindFirstChild("V" .. k)
			if not mod then
				entry.done = true
				return
			end
			sources[k] = sources[k] or require(mod)
			local n = 0
			for line in string.gmatch(sources[k], "[^\n]+") do
				if loaded[k] ~= entry then
					return -- unloaded while still building
				end
				-- a Windows checkout may turn the module into CRLF: drop the stray \r
				local f = string.split((string.gsub(line, "\r$", "")), "\t")
				if #f >= 15 then
					local p = Instance.new("Part")
					p.Name = f[1]
					p.Shape = SHAPES[f[2]] or Enum.PartType.Block
					p.Size = Vector3.new(tonumber(f[3]), tonumber(f[4]), tonumber(f[5]))
					p.CFrame = CFrame.new(tonumber(f[6]), tonumber(f[7]), tonumber(f[8]))
						* CFrame.Angles(0, 0, math.rad(tonumber(f[11])))
						* CFrame.Angles(0, math.rad(tonumber(f[10])), 0)
						* CFrame.Angles(math.rad(tonumber(f[9])), 0, 0)
					p.Color = hex(f[12])
					p.Material = MATERIALS[tonumber(f[13])] or Enum.Material.Plastic
					p.Transparency = tonumber(f[14])
					p.Anchored = true
					p.CanCollide = string.find(f[15], "c", 1, true) ~= nil
					p.CastShadow = string.find(f[15], "s", 1, true) ~= nil
					p.CanQuery, p.CanTouch = false, false
					p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
					if f[16] and f[16] ~= "" then
						local gui = Instance.new("SurfaceGui")
						gui.Face = FACES[f[16]] or Enum.NormalId.Front
						gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
						gui.PixelsPerStud = 30
						gui.LightInfluence = 0
						local t = Instance.new("TextLabel")
						t.Size = UDim2.fromScale(1, 1)
						t.TextScaled = true
						t.Font = Enum.Font.SourceSansBold
						t.TextColor3 = hex(f[17])
						t.BackgroundColor3 = hex(f[18])
						t.BackgroundTransparency = tonumber(f[19]) or 1
						t.Text = (f[20] or ""):gsub("\\n", "\n")
						t.Parent = gui
						gui.Parent = p
					end
					if f[21] and f[21] ~= "" then
						local l = string.split(f[21], ";")
						local light = Instance.new("PointLight")
						light.Brightness = tonumber(l[1]) or 1
						light.Range = tonumber(l[2]) or 16
						light.Color = hex(l[3] or "ffffff")
						light.Shadows = false
						light.Parent = p
					end
					-- ride event props start small/hidden; CartRide.client grows/reveals them
					if p.Name == "CartEvt1_Colony" then
						p:SetAttribute("FullSize", p.Size)
						p.Size = p.Size * 0.12
					end
					p.Parent = entry.folder
					n += 1
					if n % PER_FRAME == 0 then
						RunService.Heartbeat:Wait()
					end
				end
			end
			entry.done = true
		end,
	})
end
task.spawn(function()
	while true do
		local job = table.remove(queue, 1)
		if job then
			if loaded[job.k] == job.entry then
				job.run()
			end
		else
			task.wait(0.1)
		end
	end
end)

local function unload(k)
	local entry = loaded[k]
	loaded[k] = nil
	if entry then
		entry.folder:Destroy()
	end
end

-- which valley is the camera in? 0 = the station, nil = not near the ride at all
local function valleyAt(pos)
	if not (pos.X < -8800 and pos.Z > 7000 and pos.Z < 11500) then
		return nil
	end
	local k = 0
	for i, x0 in ipairs(edges) do
		if pos.X <= x0 then
			k = i
		end
	end
	return k
end

_G.BSCCartScenery = root -- for CartRide.client's ride events
while true do
	local cam = workspace.CurrentCamera
	local k = cam and valleyAt(cam.CFrame.Position)
	local want = {}
	if k then
		for v = math.max(1, k - 1), math.min(COUNT, k + 1) do
			want[v] = true
		end
		if k == 0 then
			want[1] = true
		end
	end
	for v in pairs(loaded) do
		if not want[v] then
			unload(v)
		end
	end
	if k then
		for _, v in ipairs({ math.max(k, 1), k + 1, k - 1 }) do
			if want[v] and not loaded[v] then
				build(v)
			end
		end
	end
	task.wait(0.5)
end
