local function options(...)
	local out = {}
	for _, v in ipairs({ ... }) do
		table.insert(out, { id = v[1], ar = v[2] })
	end
	return out
end
local function step(ar, correct, items, note)
	return { ar = ar, correct = correct, options = items, note = note }
end
